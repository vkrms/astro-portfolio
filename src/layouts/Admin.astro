---
import '../styles/admin.css';
import AdminShell from '../admin/components/layout/admin-shell';
import ThemeScript from '../components/ThemeScript.astro';
import DevInspector from '../components/DevInspector.astro';
import { readSiteSettings } from '../lib/settings';

interface Props {
	title: string;
	action?: { label: string; href: string };
	/** The page renders its own shadcn <Main> (demo pages). */
	bare?: boolean;
}

const { title, action, bare } = Astro.props;
const siteTitle = (await readSiteSettings()).seo.title;

// Layout state the shell saves in cookies; read here so the server render
// matches the client and the sidebar does not jump on load.
const cookies = Astro.cookies;
const sidebarOpen = cookies.get('sidebar_state')?.value !== 'false';
const collapsible = cookies.get('layout_collapsible')?.value;
const variant = cookies.get('layout_variant')?.value;
---

<!doctype html>
<html lang="en">
	<head>
		<ThemeScript />
		<meta charset="utf-8" />
		<meta
			name="viewport"
			content="width=device-width,initial-scale=1,interactive-widget=resizes-content"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title} · Admin</title>
	</head>
	<body class="bg-background pt-0 text-foreground">
		<AdminShell
			client:load
			title={title}
			action={action}
			siteTitle={siteTitle}
			href={Astro.url.pathname + Astro.url.search}
			sidebarOpen={sidebarOpen}
			collapsible={collapsible}
			variant={variant}
			bare={bare}
		>
			<slot />
		</AdminShell>
		<DevInspector />
	</body>
</html>
