---
// The hamburger menu is switched off (commented out below), so `Icon` and `nav`
// are only used by that code. Restore them with the markup, style and script.
// import { Icon } from 'astro-icon/components';
import type { SiteConfig } from '../lib/config';
import IconLink from "./IconLink.astro";

interface Props {
	config?: SiteConfig | null;
}

const { config } = Astro.props;
// const nav = (config?.nav ?? []).filter(item => item !== null);
const contactLinks = (config?.contactLinks ?? []).filter(item => item !== null);
---

<header class="w-full border-b bg-background">
	{/* With the menu button restored, use justify-between to keep it on the left. */}
	<nav class="mx-auto flex max-w-6xl items-center justify-end gap-6 px-6 py-4">
		{/*
		<button
			id="menu-toggle"
			type="button"
			aria-label="Toggle navigation menu"
			aria-controls="menu-panel"
			aria-expanded="false"
			class="inline-flex size-11 cursor-pointer items-center justify-center rounded-md text-foreground transition-colors hover:bg-accent focus-visible:ring-ring/50 focus-visible:ring-[3px] outline-none"
		>
			<Icon name="lucide:hamburger" class="icon-open size-8" />
			<Icon name="lucide:x" class="icon-close size-8" />
		</button>
		*/}
		<div class="hidden items-center gap-3 lg:flex">
			{contactLinks.map((link) => (
				<IconLink title={link.title} link={link.link} icon={link.icon} />
			))}
		</div>
	</nav>
	{/*
	<div id="menu-panel" hidden class="border-t bg-background">
		<div class="mx-auto flex max-w-6xl flex-col px-6 py-4">
			{nav.map((item) => (
				<a
					href={item.link}
					class="border-b border-border/50 py-3 text-muted-foreground transition-colors last:border-b-0 hover:text-foreground"
				>
					{item.title}
				</a>
			))}
			<div class="mt-4 flex items-center gap-2 pt-4 lg:hidden">
				{contactLinks.map((link) => (
					<IconLink title={link.title} link={link.link} icon={link.icon} />
				))}
			</div>
		</div>
	</div>
	*/}
</header>
