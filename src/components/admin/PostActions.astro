---
import type { PostSummary } from '../../lib/storage';

interface Props {
	post: PostSummary;
}

const { post } = Astro.props;
---

<div class="flex flex-wrap items-center gap-2 text-sm">
	<a href={`/admin/edit/${post.slug}`} class="hover:underline">Edit</a>
	{!post.draft && <a href={`/projects/${post.slug}`} class="hover:underline">View</a>}
	<form method="post" action="/api/duplicate">
		<input type="hidden" name="slug" value={post.slug} />
		<button type="submit" class="cursor-pointer hover:underline">Duplicate</button>
	</form>
	<form method="post" action="/api/delete" data-confirm="Delete this post?">
		<input type="hidden" name="slug" value={post.slug} />
		<button type="submit" class="cursor-pointer text-destructive hover:underline">Delete</button>
	</form>
</div>
