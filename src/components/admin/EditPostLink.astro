---
import Button from '../ui/Button.astro';

interface Props {
	slug: string;
}

const { slug } = Astro.props;
const isDev = import.meta.env.DEV;
---

<!--
	Local admin shortcut on the public post page. Public pages are prerendered,
	so this renders in dev only; production builds leave it out. The admin
	itself is gated to localhost by middleware.
-->
{
	isDev && (
		<Button href={`/admin/edit/${slug}`} variant="outline" size="sm">
			Edit post
		</Button>
	)
}
