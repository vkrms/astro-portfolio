---
// Applies the stored theme before first paint. Used by both layouts.
---

<script is:inline>
	(function () {
		function isDark() {
			try {
				const stored = localStorage.getItem('theme');
				return stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
			} catch (e) {
				return false;
			}
		}
		function apply() {
			document.documentElement.classList.toggle('dark', isDark());
		}
		apply();
		// ClientRouter swaps in the SSR'd <html> (no .dark) on navigation,
		// so re-apply the persisted theme after each swap, before paint.
		document.addEventListener('astro:after-swap', apply);
	})();
</script>
