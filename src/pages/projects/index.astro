---
import Base from '../../layouts/Base.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import ProjectCover from '../../components/media/ProjectCover.astro';
import { listPosts } from '../../lib/storage';

const posts = await listPosts({ publishedOnly: true });
const tags = [...new Set(posts.flatMap((post) => post.tags ?? []))].sort((a, b) =>
	a.localeCompare(b),
);

const chip = (active: boolean) =>
	[
		'rounded-full border px-3 py-1 transition-colors',
		active
			? 'border-primary bg-primary text-primary-foreground'
			: 'text-muted-foreground hover:border-foreground hover:text-foreground',
	].join(' ');
---

<Base title="Projects" description="Selected work.">
	<main class="mx-auto max-w-5xl px-6 py-16">
		<h1 class="text-4xl font-semibold tracking-tight">Projects</h1>

		{
			tags.length > 0 && (
				<nav aria-label="Filter by tag" class="mt-6 flex flex-wrap gap-2 text-sm">
					<button type="button" data-tag-filter="" aria-pressed="true" class={chip(true)}>
						All
					</button>
					{tags.map((item) => (
						<button
							type="button"
							data-tag-filter={item}
							aria-pressed="false"
							class={chip(false)}
						>
							{item}
						</button>
					))}
				</nav>
			)
		}

		{
			posts.length === 0 ? (
				<p class="mt-6 text-muted-foreground">No projects yet.</p>
			) : (
				<>
					<ul class="mt-10 grid list-none gap-6 p-0 sm:grid-cols-2">
						{posts.map((post) => (
							<li
								class="overflow-hidden rounded-xl border bg-card"
								data-project-card
								data-tags={JSON.stringify(post.tags ?? [])}
							>
								<ProjectCover cover={post.cover} alt={post.coverAlt} width={900} />
								<div class="p-6">
									{post.date && (
										<p class="text-sm text-muted-foreground">
											<FormattedDate date={new Date(post.date)} />
										</p>
									)}
									<h2 class="mt-2 text-xl font-semibold">
										<a href={`/projects/${post.slug}`} class="hover:underline">
											{post.title}
										</a>
									</h2>
									{post.summary && <p class="mt-2 text-muted-foreground">{post.summary}</p>}
									{post.tags && post.tags.length > 0 && (
										<ul class="mt-4 flex list-none flex-wrap gap-2 p-0 text-xs text-muted-foreground">
											{post.tags.map((item) => (
												<li>{item}</li>
											))}
										</ul>
									)}
								</div>
							</li>
						))}
					</ul>

					<p data-tag-empty hidden class="mt-6 text-muted-foreground">
						No projects match this tag.
					</p>
				</>
			)
		}
	</main>
</Base>

<script>
	import '../../scripts/tag-filter';
</script>
