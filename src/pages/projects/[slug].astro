---
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import EditPostLink from '../../components/admin/EditPostLink.astro';
import CmsImage from '../../components/media/CmsImage.astro';
import Blocks from '../../blocks/render/Blocks.astro';
import { listPosts, readPost } from '../../lib/storage';
import { ogImageUrl } from '../../lib/og';

export async function getStaticPaths() {
	const posts = await listPosts({ publishedOnly: true });
	return posts.map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const post = await readPost(slug ?? '', { publishedOnly: true });
if (!post) return new Response('Not Found', { status: 404 });

const posts = await listPosts({ publishedOnly: true });
const index = posts.findIndex((item) => item.slug === post.slug);
const newer = index > 0 ? posts[index - 1] : undefined;
const older = index >= 0 && index < posts.length - 1 ? posts[index + 1] : undefined;
const byline = [post.role, post.client].filter(Boolean).join(' · ');
const ogImage = await ogImageUrl(post.cover);
---

<Base title={post.title} description={post.summary} image={ogImage}>
	<article class="mx-auto max-w-3xl px-6 py-10">
		<header>
			<a
				href="/#work"
				aria-label="Back to projects"
				class="-ml-2 mb-6 inline-flex size-9 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-foreground focus-visible:ring-ring/50 focus-visible:ring-[3px] outline-none"
			>
				<Icon name="lucide:arrow-left" class="size-5" />
			</a>
			<div class="flex items-center justify-between gap-4">
				<p class="type-eyebrow text-muted-foreground">
					{post.date && <FormattedDate date={new Date(post.date)} />}
				</p>
				<EditPostLink slug={post.slug} />
			</div>
			<h1 class="type-heading mt-[calc(var(--type-x)*0.5)]">{post.title}</h1>
			{post.summary && <p class="type-subheading mt-1 text-muted-foreground">{post.summary}</p>}
			{byline && <p class="mt-[var(--type-x)] text-muted-foreground">{byline}</p>}
			{post.links && post.links.length > 0 && (
				<ul class="mt-6 flex list-none flex-wrap gap-4 p-0">
					{post.links.map((link) => (
						<li>
							<a
								href={link.url}
								class="font-medium text-primary hover:underline"
								rel="noopener"
								target="_blank"
							>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			)}
		</header>

		{post.cover && (
			<figure class="mt-10">
				<CmsImage
					src={post.cover}
					alt={post.coverAlt ?? ''}
					width={1400}
					class="w-full rounded-xl"
					loading="eager"
				/>
			</figure>
		)}

		<div class="mt-10">
			<Blocks blocks={post.body} />
		</div>

		<nav
			class="mt-16 flex items-center justify-between gap-4 border-t pt-6 text-sm"
			aria-label="Project navigation"
		>
			{older ? (
				<a href={`/projects/${older.slug}`} class="text-muted-foreground hover:text-foreground">
					← {older.title}
				</a>
			) : (
				<span></span>
			)}
			{newer ? (
				<a href={`/projects/${newer.slug}`} class="text-muted-foreground hover:text-foreground">
					{newer.title} →
				</a>
			) : (
				<span></span>
			)}
		</nav>
	</article>
</Base>
