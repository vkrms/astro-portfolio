---
import Base from '../layouts/Base.astro';
import Starfield from '../components/space/Starfield.astro';
---

<Base title="Portfolio" description="A personal portfolio built with Astro.">
	<section class="relative flex min-h-[70vh] items-center justify-center overflow-hidden px-6 text-center">
		<Starfield count={90} class="text-foreground/20" />
		<div class="relative flex max-w-xl flex-col items-center">
			<p class="text-sm font-medium tracking-widest text-primary uppercase">Coming soon</p>
			<h1 class="mt-2 text-4xl font-semibold tracking-tight lg:text-5xl">Portfolio</h1>
			<p class="mx-auto mt-4 max-w-md text-muted-foreground">
				The site is being rebuilt. The admin and project pages land in phase 1.
			</p>
		</div>
	</section>
</Base>
