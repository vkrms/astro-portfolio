---
import Admin from '../../layouts/Admin.astro';
import PostsTable from '../../admin/features/posts/posts-table';
import { listPosts } from '../../lib/storage';

export const prerender = false;

const status = Astro.url.searchParams.get('status');
const all = await listPosts();
const published = all.filter((post) => !post.draft);
const drafts = all.filter((post) => post.draft);
const posts = status === 'published' ? published : status === 'draft' ? drafts : all;

const filters = [
	{ label: 'All', href: '/admin', count: all.length, active: !status },
	{
		label: 'Published',
		href: '/admin?status=published',
		count: published.length,
		active: status === 'published',
	},
	{ label: 'Drafts', href: '/admin?status=draft', count: drafts.length, active: status === 'draft' },
];
---

<Admin title="Posts" action={{ label: 'New post', href: '/admin/edit/new' }}>
	<div class="mx-auto w-full max-w-5xl">
		<nav aria-label="Filter posts" class="flex flex-wrap gap-2 text-sm">
			{
				filters.map((filter) => (
					<a
						href={filter.href}
						aria-current={filter.active ? 'page' : undefined}
						class:list={[
							'rounded-md px-3 py-1.5 transition-colors',
							filter.active
								? 'bg-accent text-foreground'
								: 'text-muted-foreground hover:bg-accent hover:text-foreground',
						]}
					>
						{filter.label} ({filter.count})
					</a>
				))
			}
		</nav>

		{
			all.length === 0 ? (
				<div class="mt-10 rounded-xl border bg-card p-10 text-center">
					<p class="text-lg font-medium">No posts yet</p>
					<a
						href="/admin/edit/new"
						class="mt-4 inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground"
					>
						Create your first post
					</a>
				</div>
			) : posts.length === 0 ? (
				<div class="mt-10 rounded-xl border bg-card p-10 text-center">
					<p class="text-lg font-medium">
						{status === 'draft' ? 'No drafts' : 'No published posts'}
					</p>
					<a
						href="/admin"
						class="mt-4 inline-flex h-9 items-center justify-center rounded-md border px-4 text-sm font-medium"
					>
						Show all posts
					</a>
				</div>
			) : (
				<PostsTable
					client:load
					posts={posts.map(({ slug, title, date, draft }) => ({ slug, title, date, draft }))}
				/>
			)
		}
	</div>
</Admin>
