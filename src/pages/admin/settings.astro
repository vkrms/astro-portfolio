---
import Admin from '../../layouts/Admin.astro';
import SettingsEditor from '../../components/admin/SettingsEditor';
import { readHomeSettings, readSiteSettings } from '../../lib/settings';
import { listPosts } from '../../lib/storage';

export const prerender = false;

const [site, home, posts] = await Promise.all([
	readSiteSettings(),
	readHomeSettings(),
	listPosts(),
]);
---

<Admin title="Settings">
	<div class="mx-auto w-full max-w-4xl">
		<SettingsEditor
			client:only="react"
			site={site}
			home={home}
			posts={posts.map((post) => ({ slug: post.slug, title: post.title, draft: post.draft }))}
		/>
	</div>
</Admin>
