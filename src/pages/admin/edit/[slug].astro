---
import Admin from '../../../layouts/Admin.astro';
import PostEditor from '../../../components/admin/PostEditor';
import { readPost } from '../../../lib/storage';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) return new Response('Not Found', { status: 404 });

const post = slug === 'new' ? null : await readPost(slug);
if (slug !== 'new' && !post) return new Response('Not Found', { status: 404 });

const title = slug === 'new' ? 'New post' : 'Edit post';
---

<Admin title={title}>
	<div class="mx-auto w-full max-w-6xl">
		<a href="/admin" class="text-sm text-muted-foreground hover:text-foreground">← Back to posts</a>
		<PostEditor client:only="react" slug={slug} post={post} />
	</div>
</Admin>
