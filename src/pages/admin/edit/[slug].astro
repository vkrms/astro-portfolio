---
import '../../../styles/global.css';

export const prerender = false;

const { slug } = Astro.params;
if (slug !== 'new') return new Response('Not Found', { status: 404 });

const today = new Date().toISOString().slice(0, 10);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<title>New post</title>
	</head>
	<body class="min-h-screen bg-background text-foreground">
		<main class="mx-auto max-w-2xl px-6 py-10">
			<div class="flex items-center justify-between gap-4">
				<h1 class="text-2xl font-semibold">New post</h1>
				<a href="/admin" class="text-sm text-muted-foreground hover:text-foreground">Back to posts</a>
			</div>

			<form method="post" action="/api/save" class="mt-8 grid gap-5">
				<label class="grid gap-1.5">
					<span class="text-sm font-medium">Title</span>
					<input name="title" required maxlength="80" class="rounded-md border bg-card px-3 py-2" />
				</label>

				<label class="grid gap-1.5">
					<span class="text-sm font-medium">Slug</span>
					<input name="slug" placeholder="auto from title" class="rounded-md border bg-card px-3 py-2" />
				</label>

				<label class="grid gap-1.5">
					<span class="text-sm font-medium">Summary</span>
					<textarea name="summary" required maxlength="160" rows="3" class="rounded-md border bg-card px-3 py-2"></textarea>
				</label>

				<label class="grid gap-1.5">
					<span class="text-sm font-medium">Date</span>
					<input type="date" name="date" required value={today} class="rounded-md border bg-card px-3 py-2" />
				</label>

				<label class="flex items-center gap-2 text-sm">
					<input type="checkbox" name="draft" checked class="size-4" />
					<span>Draft</span>
				</label>

				<button
					type="submit"
					class="mt-2 inline-flex h-9 w-fit items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground shadow-xs transition-colors hover:bg-primary/90"
				>
					Save
				</button>
			</form>
		</main>
	</body>
</html>
