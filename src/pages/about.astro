---
import Base from '../layouts/Base.astro';
import Blocks from '../blocks/render/Blocks.astro';
import CmsImage from '../components/media/CmsImage.astro';
import { readAboutSettings, readSiteSettings } from '../lib/settings';

const [site, about] = await Promise.all([readSiteSettings(), readAboutSettings()]);
---

<Base title={`About · ${site.seo.title}`} description={site.seo.description}>
	<main class="mx-auto max-w-3xl px-6 py-16">
		<h1 class="text-4xl font-semibold tracking-tight lg:text-5xl">About</h1>

		{about.portrait && (
			<CmsImage
				src={about.portrait}
				alt={about.portraitAlt ?? ''}
				width={900}
				class="mt-8 w-full rounded-xl"
			/>
		)}

		<div class="mt-8">
			{about.body.length > 0 ? (
				<Blocks blocks={about.body} />
			) : (
				<p class="text-muted-foreground">No about content yet.</p>
			)}
		</div>
	</main>
</Base>
