---
import Carousel from '../../components/mdx/Carousel.astro';
import Embed from '../../components/mdx/Embed.astro';
import Gallery from '../../components/mdx/Gallery.astro';
import CmsImage from '../../components/media/CmsImage.astro';
import { parseCarouselItems } from '../shared';

interface Props {
	blocks?: unknown[] | null;
}

const { blocks = [] } = Astro.props;

type InlineNode = {
	type?: string;
	text?: string;
	href?: string;
	styles?: Record<string, boolean>;
	content?: InlineNode[];
};

type Block = {
	type?: string;
	props?: Record<string, unknown>;
	content?: InlineNode[];
};

const source = (blocks ?? []) as Block[];

function escapeHtml(value: string): string {
	return value
		.replace(/&/g, '&amp;')
		.replace(/</g, '&lt;')
		.replace(/>/g, '&gt;')
		.replace(/"/g, '&quot;');
}

function renderInline(nodes: InlineNode[] | undefined): string {
	if (!Array.isArray(nodes)) return '';

	return nodes
		.map((node) => {
			if (node.type === 'text') {
				let html = escapeHtml(node.text ?? '');
				const styles = node.styles ?? {};
				if (styles.bold) html = `<strong>${html}</strong>`;
				if (styles.italic) html = `<em>${html}</em>`;
				if (styles.code) html = `<code>${html}</code>`;
				if (styles.strike) html = `<s>${html}</s>`;
				if (styles.underline) html = `<u>${html}</u>`;
				return html;
			}

			if (node.type === 'link') {
				return `<a href="${escapeHtml(node.href ?? '')}">${renderInline(node.content)}</a>`;
			}

			return '';
		})
		.join('');
}

type Group = { kind: 'block'; block: Block } | { kind: 'list'; ordered: boolean; items: Block[] };

const groups: Group[] = [];
for (const block of source) {
	const ordered = block.type === 'numberedListItem';
	const bullet = block.type === 'bulletListItem';

	if (ordered || bullet) {
		const last = groups[groups.length - 1];
		if (last && last.kind === 'list' && last.ordered === ordered) {
			last.items.push(block);
		} else {
			groups.push({ kind: 'list', ordered, items: [block] });
		}
	} else {
		groups.push({ kind: 'block', block });
	}
}

function levelOf(value: unknown): number {
	const level = Number(value);
	return level === 1 || level === 3 ? level : 2;
}
---

<div data-blocks>
	{
		groups.map((group) => {
			if (group.kind === 'list') {
				if (group.ordered) {
					return (
						<ol class="my-4 list-outside list-decimal pl-6">
							{group.items.map((item) => (
								<li set:html={renderInline(item.content)} />
							))}
						</ol>
					);
				}

				return (
					<ul class="my-4 list-outside list-disc pl-6">
						{group.items.map((item) => (
							<li set:html={renderInline(item.content)} />
						))}
					</ul>
				);
			}

			const block = group.block;
			const type = block.type ?? 'paragraph';

			if (type === 'paragraph') {
				return <p class="my-4" set:html={renderInline(block.content)} />;
			}

			if (type === 'heading') {
				const level = levelOf(block.props?.level);
				// H1 and H2 use the display size; H3 stays at body size.
				const className =
					level === 3
						? 'mt-8 mb-3 font-semibold tracking-tight'
						: 'type-heading mt-12 mb-4';
				const html = renderInline(block.content);

				if (level === 1) return <h1 class={className} set:html={html} />;
				if (level === 3) return <h3 class={className} set:html={html} />;
				return <h2 class={className} set:html={html} />;
			}

			if (type === 'image') {
				// `url` is the prop used by BlockNote's default image block, which
				// posts created before the custom block may still contain.
				const src = String(block.props?.src ?? block.props?.url ?? '');
				if (!src) return null;

				const alt = String(block.props?.alt ?? '');
				const caption = String(block.props?.caption ?? '');
				const width = String(block.props?.width ?? 'wide');
				const widthClass =
					width === 'inline' ? 'mx-auto max-w-xl' : width === 'full' ? 'w-full' : 'mx-auto max-w-3xl';

				return (
					<figure class:list={['my-8', widthClass]}>
						<CmsImage src={src} alt={alt} width={1200} class="w-full rounded-xl" />
						{caption && (
							<figcaption class="mt-2 text-center text-sm text-muted-foreground">
								{caption}
							</figcaption>
						)}
					</figure>
				);
			}

			if (type === 'carousel') {
				const slides = parseCarouselItems(block.props?.items).map((item) => ({
					image: item.src,
					alt: item.alt,
					caption: item.caption,
				}));

				return <Carousel slides={slides} aspect={String(block.props?.aspect ?? '16/9')} />;
			}

			if (type === 'gallery') {
				return (
					<Gallery
						items={block.props?.items}
						columns={String(block.props?.columns ?? '3')}
					/>
				);
			}

			if (type === 'quote') {
				const attribution = String(block.props?.attribution ?? '');

				return (
					<blockquote class="my-6 border-l-2 pl-4 text-lg italic">
						<p class="m-0" set:html={renderInline(block.content)} />
						{attribution && (
							<cite class="mt-2 block text-sm not-italic text-muted-foreground">— {attribution}</cite>
						)}
					</blockquote>
				);
			}

			if (type === 'mediaText') {
				const src = String(block.props?.src ?? '');
				if (!src) return null;

				const alt = String(block.props?.alt ?? '');
				const side = String(block.props?.side ?? 'left');

				return (
					<div class="my-8 grid items-center gap-6 sm:grid-cols-2">
						<CmsImage
							src={src}
							alt={alt}
							width={800}
							class={side === 'right' ? 'w-full rounded-xl sm:order-2' : 'w-full rounded-xl'}
						/>
						<div class="prose max-w-none" set:html={renderInline(block.content)} />
					</div>
				);
			}

			if (type === 'embed') {
				return (
					<Embed
						url={String(block.props?.url ?? '')}
						title={String(block.props?.title ?? '')}
						aspect={String(block.props?.aspect ?? '16/9')}
					/>
				);
			}

			if (type === 'codeBlock') {
				const text = (block.content ?? []).map((node) => node.text ?? '').join('');
				return (
					<pre class="my-4 overflow-x-auto rounded-lg border bg-card p-4 text-sm">
						<code>{text}</code>
					</pre>
				);
			}

			return null;
		})
	}
</div>

<script>
	import '../../scripts/embeds';
</script>
