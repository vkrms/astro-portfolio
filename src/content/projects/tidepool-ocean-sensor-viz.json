			"content": [
				{
					"type": "text",
					"text": "The research group collects a reading every ten minutes from forty sensors. Researchers used spreadsheets; the public saw nothing. ",
					"styles": {}
				},
				{
					"type": "text",
					"text": "Tidepool",
					"styles": {
						"bold": true
					}
				},
