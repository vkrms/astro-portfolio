				},
				{
					"type": "text",
					"text": "Orbit",
					"styles": {
						"bold": true
					}
				},
				{
					"type": "text",
					"text": " tries the opposite: ",
					"styles": {}
				},
				{
					"type": "text",
					"text": "progress is a shape that is hard to break",
					"styles": {
						"italic": true
					}
				},
				{
					"type": "text",
					"text": ".",
					"styles": {}
				}
